# FlagRisk website environment variables.
# Copy to .env.local for development. NEVER commit real keys.
# NEXT_PUBLIC_ values are exposed to the browser (safe to be public).
# All others are server-only secrets.

# --- Supabase (project ref aqgkntulbuqqqjxjafmw) ---
NEXT_PUBLIC_SUPABASE_URL=https://aqgkntulbuqqqjxjafmw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=            # Supabase > Project Settings > API > anon public key
SUPABASE_SERVICE_ROLE_KEY=                # Supabase > Project Settings > API > service_role key (SECRET, server only)

# --- Paystack (payments + payouts) ---
# Use test keys first (pk_test_... / sk_test_...), swap to live for production.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=                  # same as PAYSTACK_SECRET_KEY unless a separate signing key is set

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000   # set to https://flagrisk.org in production
